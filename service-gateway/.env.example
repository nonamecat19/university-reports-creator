# Service Gateway
HTTP_PORT=:8080

# JWT (RS256 public key only — the gateway never signs tokens; FR-AUTH-03)
JWT_PUBLIC_KEY_PATH=../certs/jwt_public.pem

# Service Discovery (local mode)
SERVICE_AUTH=localhost:50051
SERVICE_DOCUMENT=localhost:50052
SERVICE_FILES=localhost:50053

# CORS
CLIENT_ORIGIN=http://localhost:4200