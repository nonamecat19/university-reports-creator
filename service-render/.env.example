# ── service-render configuration ──────────────────────────────────────
PORT=50054
LOG_LEVEL=INFO
JSON_LOGGING=false

# Max decompressed size accepted from an uploaded docx zip, guards against
# zip bombs (NFR-09).
MAX_DECOMPRESSED_BYTES=314572800

# LibreOffice headless binary used for .doc->.docx conversion (FR-TPL-01) and
# docx->PDF conversion (FR-EXP-01 step 8). Must be on PATH or an absolute path.
LIBREOFFICE_BIN=soffice
LIBREOFFICE_TIMEOUT_SECONDS=60
