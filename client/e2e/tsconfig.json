{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "paths": {
      "@gen/*": ["../../gen/ts/*"]
    },
    "types": ["node"]
  },
  "include": ["**/*.ts", "../playwright.config.ts"]
}
