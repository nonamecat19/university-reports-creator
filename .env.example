# =============================================================================
# Service Discovery (local mode - no Consul needed)
# =============================================================================
# Set these so gateway knows where other services are
SERVICE_AUTH=localhost:50051
SERVICE_DOCUMENT=localhost:50052
SERVICE_FILES=localhost:50053

# =============================================================================
# Service Auth
# =============================================================================
GRPC_PORT=:50051
# RS256 keypair (run `make certs` to generate); gateway only needs the public half.
JWT_PRIVATE_KEY_PATH=./certs/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./certs/jwt_public.pem
ACCESS_TOKEN_DURATION=15m
REFRESH_TOKEN_DURATION=720h
DATABASE_URL=postgres://postgres:postgres@localhost:5432/auth?sslmode=disable

# =============================================================================
# Service Document
# =============================================================================
GRPC_PORT=:50052
SURREALDB_URL=ws://localhost:8000
SURREALDB_USERNAME=root
SURREALDB_PASSWORD=root
SURREALDB_NAMESPACE=diploma
SURREALDB_DATABASE=main

# =============================================================================
# Service Files
# =============================================================================
GRPC_PORT=:50053
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=files
MINIO_USE_SSL=false

# =============================================================================
# Service Gateway
# =============================================================================
HTTP_PORT=:8080
CLIENT_ORIGIN=http://localhost:4200

# =============================================================================
# Infrastructure
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=auth
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin